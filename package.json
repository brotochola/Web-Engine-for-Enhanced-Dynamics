{
  "name": "@weed.js/engine",
  "version": "0.7.14",
  "description": "A multithreaded 2D web game engine for high-entity-count browser games",
  "type": "module",
  "main": "dist/weed.bundle.min.js",
  "module": "dist/weed.bundle.esm.min.js",
  "types": "./types/weed.d.ts",
  "exports": {
    ".": {
      "types": "./types/weed.d.ts",
      "import": "./dist/weed.bundle.esm.min.js",
      "require": "./dist/weed.bundle.min.js",
      "default": "./dist/weed.bundle.min.js"
    }
  },
  "files": [
    "dist/*.min.js",
    "types",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "test": "tests",
    "doc": "docs"
  },
  "scripts": {
    "prepare": "node scripts/installGitHooks.js",
    "prepublishOnly": "node scripts/assertDistBundles.js",
    "sync:version": "node scripts/syncVersion.js",
    "dev": "node server/node_server.js",
    "pretest:node": "node scripts/syncVersion.js",
    "test": "npm run test:node",
    "test:node": "node --test tests/node/*.test.js",
    "test:bundle": "node scripts/smokeBundleEmbed.mjs && node scripts/smokeBundleBrowser.mjs",
    "test:bundle:build": "npm run make_bundle && npm run test:bundle",
    "test:all": "npm run test:node && npm run test:browser",
    "test:visual": "node tests/bench/runLockstepVisual.mjs",
    "test:visual:against": "node tests/bench/runLockstepVisual.mjs --against",
    "test:browser": "npm run test:bundle:build && node tests/bench/sceneCycleSmoke.mjs",
    "check:types": "npx -p typescript@5.7.2 tsc --noEmit --skipLibCheck types/weed.d.ts types/utils.d.ts",
    "pretest:bench": "node scripts/syncVersion.js",
    "test:bench": "node tests/bench/runIntegratedWorkerBenchmark.mjs",
    "test:bench:headed": "node tests/bench/runIntegratedWorkerBenchmark.mjs --headed",
    "bench:headed:profile": "node tests/bench/runIntegratedWorkerBenchmark.mjs --headed --trace",
    "bench:headed:median": "node tests/bench/runHeadedMedian.mjs",
    "bench:box2d:pthread-lto": "node tests/bench/runBox2dPthreadLtoMatrix.mjs",
    "bench:box2d:flto-mode": "node tests/bench/runBox2dFltoModeBench.mjs",
    "bench:headed:spatial-confirm": "node tests/bench/runHeadedMedian.mjs --runs 6 --json-out tests/results/research-spatial-headed.json",
    "bench:spatial:hypothesis-battery": "node tests/bench/runSpatialHypothesisBattery.mjs",
    "bench:study:spatial-cell": "node tests/bench/runSpatialCellStudy.mjs",
    "bench:workers": "node tests/bench/runIntegratedWorkerBenchmark.mjs",
    "bench:micro:ray": "node tests/bench/rayMicrobench.mjs",
    "bench:micro:ray-vs-box2d": "node tests/bench/rayVsBox2dMicrobench.mjs",
    "bench:feature:ray": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayStressScene.js --scene-export RayStressScene --output tests/results/ray-stress.json",
    "bench:feature:ray-vs-box2d:weedjs:idle": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayVsBox2dStressScene.js --scene-export RayVsBox2dWeedIdleScene --output tests/results/ray-vs-box2d-weed-idle.json",
    "bench:feature:ray-vs-box2d:weedjs:busy": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayVsBox2dStressScene.js --scene-export RayVsBox2dWeedBusyScene --output tests/results/ray-vs-box2d-weed-busy.json",
    "bench:feature:ray-vs-box2d:box2d:idle": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayVsBox2dStressScene.js --scene-export RayVsBox2dBoxIdleScene --output tests/results/ray-vs-box2d-box-idle.json",
    "bench:feature:ray-vs-box2d:box2d:busy": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayVsBox2dStressScene.js --scene-export RayVsBox2dBoxBusyScene --output tests/results/ray-vs-box2d-box-busy.json",
    "bench:feature:ray:predator": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /demos/predatorScene/predatorScene.js --scene-export PredatorScene --output tests/results/ray-predator.json",
    "bench:ray:hyps": "node tests/bench/runRayHypCampaign.mjs",
    "bench:ray:tournament": "node tests/bench/runRayHypTournament.mjs",
    "bench:micro:decal": "node tests/bench/decalMicrobench.mjs",
    "bench:feature:decal": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/decalStampStressScene.js --scene-export DecalStampStressScene --output tests/results/decal-stress.json",
    "bench:decal:tournament": "node tests/bench/runDecalHypTournament.mjs",
    "bench:micro:particle-emit": "node tests/bench/particleEmitMicrobench.mjs",
    "bench:micro:particle-ease": "node tests/bench/particleEaseMicrobench.mjs",
    "bench:micro:particle-integrate": "node tests/bench/particleIntegrateMicrobench.mjs",
    "bench:feature:particle-emit": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/particleEmitStressScene.js --scene-export ParticleEmitStressScene --output tests/results/particle-emit-stress.json",
    "bench:feature:particle-integrate": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/particleIntegrateStressScene.js --scene-export ParticleIntegrateStressScene --output tests/results/particle-integrate-stress.json",
    "bench:particle:tournament": "node tests/bench/runParticleHypTournament.mjs",
    "bench:feature:liquidfun": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/liquidFunStressScene.js --scene-export LiquidFunStressScene --output tests/results/liquidfun-stress.json",
    "bench:feature:liquidfun-query": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/liquidFunQueryStressScene.js --scene-export LiquidFunQueryStressScene --output tests/results/liquidfun-query-stress.json",
    "bench:feature:liquidfun-bodycouple": "node tests/bench/runIntegratedWorkerBenchmark.mjs --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/liquidFunBodyCoupleStressScene.js --scene-export LiquidFunBodyCoupleStressScene --output tests/results/liquidfun-bodycouple-stress.json",
    "bench:feature:liquidfun-manyshapes": "node tests/bench/runIntegratedWorkerBenchmark.mjs --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/liquidFunManyShapesStressScene.js --scene-export LiquidFunManyShapesStressScene --output tests/results/liquidfun-manyshapes-stress.json",
    "bench:micro:liquidfun-capturepairs": "node tests/bench/liquidFunCapturePairsMicrobench.mjs",
    "bench:micro:liquidfun-computedepth": "node tests/bench/liquidFunComputeDepthMicrobench.mjs",
    "bench:micro:liquidfun-extract": "node tests/bench/liquidFunExtractMicrobench.mjs",
    "bench:micro:liquidfun-reactive": "node tests/bench/liquidFunReactiveMicrobench.mjs",
    "bench:micro:liquidfun-sparse-step": "node tests/bench/liquidFunSparseStepMicrobench.mjs",
    "bench:micro:liquidfun-rigiddamping": "node tests/bench/liquidFunRigidDampingMicrobench.mjs",
    "bench:micro:liquidfun-bodycouple": "node tests/bench/liquidFunBodyCoupleMicrobench.mjs",
    "bench:micro:liquidfun-overlap-substep": "node tests/bench/liquidFunOverlapSubstepMicrobench.mjs",
    "bench:micro:liquidfun-strict-contact": "node tests/bench/liquidFunStrictContactMicrobench.mjs",
    "bench:micro:liquidfun-pass-profile": "node tests/bench/liquidFunPassProfileMicrobench.mjs",
    "bench:micro:log-pair": "node tests/bench/logPairMicrobench.mjs",
    "bench:micro:par-cam": "node tests/bench/parCamMicrobench.mjs",
    "bench:micro:pre-anim": "node tests/bench/preAnimMicrobench.mjs",
    "bench:micro:pre-hot": "node tests/bench/preHotMicrobench.mjs",
    "bench:micro:layer-collect": "node tests/bench/layerCollectMicrobench.mjs",
    "bench:micro:instanced-pack": "node tests/bench/instancedPackMicrobench.mjs",
    "bench:micro:sr-flags": "node tests/bench/srFlagsMicrobench.mjs",
    "bench:micro:hyp-wins": "node tests/bench/runHypWinsMicrobenches.mjs",
    "bench:micro:compute-pack": "node tests/bench/computePackMicrobench.mjs",
    "bench:feature:compute": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/computeStressScene.js --scene-export ComputeStressScene --output tests/results/compute-stress.json",
    "bench:feature:compute:headed": "node tests/bench/runIntegratedWorkerBenchmark.mjs --headed --scene /tests/bench/stressScenes/computeStressScene.js --scene-export ComputeStressScene --output tests/results/compute-stress-headed.json",
    "verify:pose-interpolation": "node tests/bench/poseInterpolationVerify.mjs",
    "bake:atlas": "node scripts/bakeBigAtlas.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "premake_bundle": "node scripts/syncVersion.js",
    "make_bundle": "node scripts/buildBundle.js",
    "make_bundle:obfuscate": "node scripts/buildBundle.js --obfuscate",
    "premake_prod_bundle": "node scripts/syncVersion.js",
    "make_prod_bundle": "node scripts/buildBundle.js",
    "build:pixi": "node scripts/buildPixi.mjs",
    "prebuild:docs": "node scripts/syncVersion.js",
    "build:docs": "node scripts/buildDocs.js",
    "clean": "rimraf dist"
  },
  "keywords": [
    "weed.js",
    "weedjs",
    "game-engine",
    "web-game-engine",
    "html5-game-engine",
    "2d",
    "webgl",
    "multithreaded",
    "web-worker",
    "sharedarraybuffer",
    "box2d",
    "wasm",
    "ecs",
    "entity-component-system",
    "pixi.js",
    "physics",
    "liquidfun",
    "webgpu",
    "offscreen-canvas"
  ],
  "author": "Facundo Saiegh",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brotochola/MultithreadedGameEngine.git"
  },
  "bugs": {
    "url": "https://github.com/brotochola/MultithreadedGameEngine/issues"
  },
  "homepage": "https://multithreaded-game-engine.vercel.app/demos",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "javascript-obfuscator": "^4.1.0",
    "pixi.js": "8.20.1",
    "playwright": "^1.62.1",
    "prettier": "^3.8.0",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-obfuscator": "^3.5.1"
  }
}
