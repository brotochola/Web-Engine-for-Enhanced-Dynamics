{
  "name": "@weed.js/engine",
  "version": "0.7.61",
  "description": "A multithreaded 2D web game engine for high-entity-count browser games",
  "type": "module",
  "main": "dist/weed.prod.bundle.min.js",
  "module": "dist/weed.prod.bundle.esm.min.js",
  "types": "./types/weed.d.ts",
  "unpkg": "dist/weed.prod.bundle.min.js",
  "jsdelivr": "dist/weed.prod.bundle.min.js",
  "exports": {
    ".": {
      "types": "./types/weed.d.ts",
      "import": "./dist/weed.prod.bundle.esm.min.js",
      "require": "./dist/weed.prod.bundle.min.js",
      "default": "./dist/weed.prod.bundle.min.js"
    },
    "./debug": {
      "types": "./types/weed.d.ts",
      "import": "./dist/weed.bundle.esm.min.js",
      "require": "./dist/weed.bundle.min.js",
      "default": "./dist/weed.bundle.min.js"
    }
  },
  "files": [
    "dist/*.min.js",
    "types",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "test": "tests",
    "doc": "docs"
  },
  "scripts": {
    "prepare": "node scripts/installGitHooks.js",
    "prepublishOnly": "node scripts/assertDistBundles.js",
    "sync:version": "node scripts/syncVersion.js",
    "dev": "node server/node_server.js",
    "pretest:node": "node scripts/syncVersion.js",
    "test": "npm run test:node",
    "test:node": "node --test --test-concurrency=4 tests/node/*.test.js",
    "test:node:bundle": "node scripts/runNodeTestsOnBundle.mjs",
    "test:node:bundle:build": "npm run make_bundle && npm run test:node:bundle",
    "test:bundle": "node scripts/smokeBundleEmbed.mjs && node scripts/smokeBundleBrowser.mjs",
    "test:bundle:build": "npm run make_bundle && npm run test:bundle",
    "test:all": "npm run test:node && npm run test:browser",
    "test:visual": "node tests/bench/runLockstepVisual.mjs",
    "test:visual:against": "node tests/bench/runLockstepVisual.mjs --against",
    "test:browser": "npm run make_bundle && npm run test:node:bundle && npm run test:bundle && node tests/bench/sceneCycleSmoke.mjs",
    "check:types": "npx -p typescript@5.7.2 tsc --noEmit --skipLibCheck types/weed.d.ts types/utils.d.ts",
    "pretest:bench": "node scripts/syncVersion.js",
    "test:bench": "node tests/bench/runIntegratedWorkerBenchmark.mjs",
    "test:bench:headed": "node tests/bench/runIntegratedWorkerBenchmark.mjs --headed",
    "bench:headed:profile": "node tests/bench/runIntegratedWorkerBenchmark.mjs --headed --trace",
    "bench:headed:median": "node tests/bench/runHeadedMedian.mjs",
    "bench:box2d:pthread-lto": "node tests/bench/runBox2dPthreadLtoMatrix.mjs",
    "bench:box2d:flto-mode": "node tests/bench/runBox2dFltoModeBench.mjs",
    "bench:headed:spatial-confirm": "node tests/bench/runHeadedMedian.mjs --runs 6 --json-out tests/results/research-spatial-headed.json",
    "bench:spatial:hypothesis-battery": "node tests/bench/runSpatialHypothesisBattery.mjs",
    "bench:spatial:campaign": "node tests/bench/runSpatialHypCampaign.mjs",
    "bench:spatial:tournament": "node tests/bench/runSpatialHypTournament.mjs",
    "bench:micro:spatial": "node tests/bench/spatialMicrobench.mjs",
    "bench:feature:spatial": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/stationarySpatialScene.js --scene-export StationarySpatialScene --output tests/results/stationary-spatial.json",
    "bench:micro:query": "node tests/bench/querySystemMicrobench.mjs",
    "bench:feature:query-churn": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/queryChurnScene.js --scene-export QueryChurnScene --output tests/results/query-churn.json",
    "bench:feature:query-aabb": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/queryAabbStressScene.js --scene-export QueryAabbStressScene --output tests/results/query-aabb-stress.json",
    "bench:micro:angular-sweep": "node tests/bench/angularSweepMicrobench.mjs",
    "bench:micro:decoration-spatial": "node tests/bench/decorationSpatialMicrobench.mjs",
    "bench:micro:nav": "node tests/bench/navGridMicrobench.mjs",
    "bench:feature:nav": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/navStressScene.js --scene-export NavStressScene --output tests/results/nav-stress.json",
    "bench:micro:tilemap": "node tests/bench/tileMapMicrobench.mjs",
    "bench:micro:tilemap-gid": "node tests/bench/tilemapGidMicrobench.mjs",
    "bench:feature:tilemap-gid": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/tilemapCullStressScene.js --scene-export TilemapCullStressScene --output tests/results/tilemap-gid-stress.json",
    "bench:feature:contact-drain": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/contactDrainStressScene.js --scene-export ContactDrainStressScene --output tests/results/contact-drain-stress.json",
    "bench:micro:treiber": "node tests/bench/treiberMicrobench.mjs",
    "bench:feature:spawn-storm": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/spawnStormScene.js --scene-export SpawnStormScene --output tests/results/spawn-storm.json",
    "bench:micro:spawn-ring": "node tests/bench/spawnCommandRingMicrobench.mjs",
    "bench:micro:pose-skip": "node tests/bench/poseSkipMicrobench.mjs",
    "bench:micro:skip-work": "node tests/bench/skipWorkMicrobench.mjs",
    "bench:micro:body-pack": "node tests/bench/bodyPackMicrobench.mjs",
    "bench:micro:particle-l1": "node tests/bench/particleL1Microbench.mjs",
    "bench:study:spatial-cell": "node tests/bench/runSpatialCellStudy.mjs",
    "bench:workers": "node tests/bench/runIntegratedWorkerBenchmark.mjs",
    "bench:micro:ray": "node tests/bench/rayMicrobench.mjs",
    "bench:micro:ray-vs-box2d": "node tests/bench/rayVsBox2dMicrobench.mjs",
    "bench:feature:ray": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayStressScene.js --scene-export RayStressScene --output tests/results/ray-stress.json",
    "bench:feature:ray-vs-box2d:weedjs:idle": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayVsBox2dStressScene.js --scene-export RayVsBox2dWeedIdleScene --output tests/results/ray-vs-box2d-weed-idle.json",
    "bench:feature:ray-vs-box2d:weedjs:busy": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayVsBox2dStressScene.js --scene-export RayVsBox2dWeedBusyScene --output tests/results/ray-vs-box2d-weed-busy.json",
    "bench:feature:ray-vs-box2d:box2d:idle": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayVsBox2dStressScene.js --scene-export RayVsBox2dBoxIdleScene --output tests/results/ray-vs-box2d-box-idle.json",
    "bench:feature:ray-vs-box2d:box2d:busy": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/rayVsBox2dStressScene.js --scene-export RayVsBox2dBoxBusyScene --output tests/results/ray-vs-box2d-box-busy.json",
    "bench:feature:ray:predator": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /demos/predatorScene/predatorScene.js --scene-export PredatorScene --output tests/results/ray-predator.json",
    "bench:ray:hyps": "node tests/bench/runRayHypCampaign.mjs",
    "bench:ray:tournament": "node tests/bench/runRayHypTournament.mjs",
    "bench:micro:decal": "node tests/bench/decalMicrobench.mjs",
    "bench:feature:decal": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/decalStampStressScene.js --scene-export DecalStampStressScene --output tests/results/decal-stress.json",
    "bench:decal:tournament": "node tests/bench/runDecalHypTournament.mjs",
    "bench:micro:particle-emit": "node tests/bench/particleEmitMicrobench.mjs",
    "bench:micro:particle-ease": "node tests/bench/particleEaseMicrobench.mjs",
    "bench:micro:particle-integrate": "node tests/bench/particleIntegrateMicrobench.mjs",
    "bench:micro:bullets": "node tests/bench/bulletTickMicrobench.mjs",
    "bench:micro:deco-sway": "node tests/bench/decorationSwayMicrobench.mjs",
    "bench:pool-flow": "node tests/bench/runPoolFlowCampaign.mjs",
    "bench:bullets:pyramid": "node tests/bench/runBulletPyramidAb.mjs",
    "bench:feature:particle-emit": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/particleEmitStressScene.js --scene-export ParticleEmitStressScene --output tests/results/particle-emit-stress.json",
    "bench:feature:particle-integrate": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/particleIntegrateStressScene.js --scene-export ParticleIntegrateStressScene --output tests/results/particle-integrate-stress.json",
    "bench:feature:bullets": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --scene /tests/bench/stressScenes/bulletStressScene.js --scene-export BulletStressScene --output tests/results/bullet-stress.json",
    "bench:particle:tournament": "node tests/bench/runParticleHypTournament.mjs",
    "bench:micro-opts:ab": "node tests/bench/runMicroOptsAb.mjs",
    "bench:micro-opts:ab:dry": "node tests/bench/runMicroOptsAb.mjs --dry-apply",
    "bench:product-confirm": "node tests/bench/runProductConfirm.mjs",
    "bench:scoreboard": "node tests/bench/runScoreboard.mjs",
    "bench:feature:liquidfun": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/liquidFunStressScene.js --scene-export LiquidFunStressScene --output tests/results/liquidfun-stress.json",
    "bench:feature:liquidfun-query": "node tests/bench/runIntegratedWorkerBenchmark.mjs --scene /tests/bench/stressScenes/liquidFunQueryStressScene.js --scene-export LiquidFunQueryStressScene --output tests/results/liquidfun-query-stress.json",
    "bench:feature:liquidfun-bodycouple": "node tests/bench/runIntegratedWorkerBenchmark.mjs --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/liquidFunBodyCoupleStressScene.js --scene-export LiquidFunBodyCoupleStressScene --output tests/results/liquidfun-bodycouple-stress.json",
    "bench:feature:liquidfun-manyshapes": "node tests/bench/runIntegratedWorkerBenchmark.mjs --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/liquidFunManyShapesStressScene.js --scene-export LiquidFunManyShapesStressScene --output tests/results/liquidfun-manyshapes-stress.json",
    "bench:micro:liquidfun-capturepairs": "node tests/bench/liquidFunCapturePairsMicrobench.mjs",
    "bench:micro:liquidfun-computedepth": "node tests/bench/liquidFunComputeDepthMicrobench.mjs",
    "bench:micro:liquidfun-extract": "node tests/bench/liquidFunExtractMicrobench.mjs",
    "bench:micro:liquidfun-reactive": "node tests/bench/liquidFunReactiveMicrobench.mjs",
    "bench:micro:liquidfun-sparse-step": "node tests/bench/liquidFunSparseStepMicrobench.mjs",
    "bench:micro:liquidfun-rigiddamping": "node tests/bench/liquidFunRigidDampingMicrobench.mjs",
    "bench:micro:liquidfun-bodycouple": "node tests/bench/liquidFunBodyCoupleMicrobench.mjs",
    "bench:micro:liquidfun-overlap-substep": "node tests/bench/liquidFunOverlapSubstepMicrobench.mjs",
    "bench:micro:liquidfun-strict-contact": "node tests/bench/liquidFunStrictContactMicrobench.mjs",
    "bench:micro:liquidfun-pass-profile": "node tests/bench/liquidFunPassProfileMicrobench.mjs",
    "bench:micro:log-pair": "node tests/bench/logPairMicrobench.mjs",
    "bench:micro:par-cam": "node tests/bench/parCamMicrobench.mjs",
    "bench:micro:pre-anim": "node tests/bench/preAnimMicrobench.mjs",
    "bench:micro:pre-hot": "node tests/bench/preHotMicrobench.mjs",
    "bench:micro:layer-collect": "node tests/bench/layerCollectMicrobench.mjs",
    "bench:micro:instanced-pack": "node tests/bench/instancedPackMicrobench.mjs",
    "bench:micro:sr-flags": "node tests/bench/srFlagsMicrobench.mjs",
    "bench:micro:hyp-wins": "node tests/bench/runHypWinsMicrobenches.mjs",
    "bench:micro:compute-pack": "node tests/bench/computePackMicrobench.mjs",
    "bench:micro:collider-fill-pack": "node tests/bench/colliderFillPackMicrobench.mjs",
    "bench:micro:decal-blit": "node tests/bench/decalBlitPackMicrobench.mjs",
    "bench:micro:scenery-cam": "node tests/bench/sceneryCamMicrobench.mjs",
    "bench:micro:mesh-camera": "node tests/bench/meshCameraUniformMicrobench.mjs",
    "bench:feature:decal-blit": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/decalBlitStressScene.js --scene-export DecalBlitStressScene --output tests/results/pixi-peel/h1a-decal-blit/stress.json",
    "bench:feature:scenery-cam": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/sceneryCamStressScene.js --scene-export SceneryCamStressScene --output tests/results/pixi-peel/h1c-scenery/stress.json",
    "bench:feature:mesh-fill-pan": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/meshFillPanScene.js --scene-export MeshFillPanScene --output tests/results/pixi-peel/h2-mesh-camera/stress.json",
    "bench:feature:mesh-fill-look": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/meshFillLookPanScene.js --scene-export MeshFillLookPanScene --output tests/results/pixi-peel/h3-mesh-look/stress.json",
    "bench:mesh-look-uv": "node tests/bench/meshLookUvCorrectness.mjs",
    "bench:micro:collider-fixture-bounds": "node tests/bench/colliderFixtureBoundsMicrobench.mjs",
    "bench:micro:replace-polygons": "node tests/bench/replacePolygonsMicrobench.mjs",
    "bench:feature:compound-spatial": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/compoundFixtureSpatialScene.js --scene-export CompoundFixtureSpatialScene --output tests/results/multi-fixture/compound-spatial.json",
    "bench:feature:compound-geom-dirty": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/compoundGeometryDirtyScene.js --scene-export CompoundGeometryDirtyScene --output tests/results/multi-fixture/compound-geom-dirty.json",
    "bench:feature:mesh-fill-static": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/meshFillStaticScene.js --scene-export MeshFillStaticScene --output tests/results/multi-fixture/mesh-fill-static.json",
    "bench:feature:minimal-tick": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/minimalTickScene.js --scene-export MinimalTickScene --output tests/results/minimal-tick/instance.json",
    "bench:feature:minimal-tick-all": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/minimalTickAllScene.js --scene-export MinimalTickAllScene --output tests/results/minimal-tick/tickall.json",
    "bench:micro:toy-world-bounce": "node tests/bench/toyWorldBounceMicrobench.mjs",
    "bench:feature:bunny-mark": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/bunnyMarkStressScene.js --scene-export BunnyMarkStressScene --output tests/results/bunny-mover/a.json",
    "bench:feature:bunny-mark-c": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/bunnyMarkStressScene.js --scene-export BunnyMarkStressCScene --output tests/results/bunny-mover/c.json",
    "bench:feature:bunny-mark-d": "node tests/bench/runIntegratedWorkerBenchmark.mjs --src --warmup-ms 8000 --duration-ms 10000 --scene /tests/bench/stressScenes/bunnyMarkStressScene.js --scene-export BunnyMarkStressDScene --output tests/results/bunny-mover/d.json",
