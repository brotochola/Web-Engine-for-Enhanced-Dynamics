{
  "name": "@weed.js/engine",
  "version": "0.7.14",
  "description": "A multithreaded 2D web game engine for high-entity-count browser games",
  "type": "module",
  "main": "dist/weed.bundle.min.js",
  "module": "dist/weed.bundle.esm.min.js",
  "types": "./types/weed.d.ts",
  "exports": {
    ".": {
      "types": "./types/weed.d.ts",
      "import": "./dist/weed.bundle.esm.min.js",
      "require": "./dist/weed.bundle.min.js",
      "default": "./dist/weed.bundle.min.js"
    },
    "./src": {
      "types": "./types/weed.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "test": "tests",
    "doc": "docs"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "sync:version": "node scripts/sync-version.js",
    "dev": "node server/node_server.js",
    "pretest:node": "node scripts/sync-version.js",
    "test": "npm run test:node",
    "test:node": "node --test tests/node/*.test.js",
    "test:bundle": "node scripts/smoke-bundle-embed.mjs && node scripts/smoke-bundle-browser.mjs",
    "test:bundle:build": "npm run make_bundle && npm run test:bundle",
    "test:all": "npm run test:node && npm run test:browser",
    "test:visual": "node tests/bench/run-lockstep-visual.mjs",
    "test:visual:against": "node tests/bench/run-lockstep-visual.mjs --against",
    "test:browser": "npm run test:bundle:build && node tests/bench/scene-cycle-smoke.mjs",
    "check:types": "npx -p typescript@5.7.2 tsc --noEmit --skipLibCheck types/weed.d.ts types/utils.d.ts",
    "pretest:bench": "node scripts/sync-version.js",
    "test:bench": "node tests/bench/run-integrated-worker-benchmark.mjs",
    "test:bench:headed": "node tests/bench/run-integrated-worker-benchmark.mjs --headed",
    "bench:headed:profile": "node tests/bench/run-integrated-worker-benchmark.mjs --headed --trace",
    "bench:headed:median": "node tests/bench/run-headed-median.mjs",
    "bench:box2d:pthread-lto": "node tests/bench/run-box2d-pthread-lto-matrix.mjs",
    "bench:box2d:flto-mode": "node tests/bench/run-box2d-flto-mode-bench.mjs",
    "bench:headed:spatial-confirm": "node tests/bench/run-headed-median.mjs --runs 6 --json-out tests/results/research-spatial-headed.json",
    "bench:spatial:hypothesis-battery": "node tests/bench/run-spatial-hypothesis-battery.mjs",
    "bench:study:spatial-cell": "node tests/bench/run-spatial-cell-study.mjs",
    "bench:workers": "node tests/bench/run-integrated-worker-benchmark.mjs",
    "bench:micro:ray": "node tests/bench/ray-microbench.mjs",
    "bench:micro:ray-vs-box2d": "node tests/bench/ray-vs-box2d-microbench.mjs",
    "bench:feature:ray": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/RayStressScene.js --scene-export RayStressScene --output tests/results/ray-stress.json",
    "bench:feature:ray-vs-box2d:weedjs:idle": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/RayVsBox2dStressScene.js --scene-export RayVsBox2dWeedIdleScene --output tests/results/ray-vs-box2d-weed-idle.json",
    "bench:feature:ray-vs-box2d:weedjs:busy": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/RayVsBox2dStressScene.js --scene-export RayVsBox2dWeedBusyScene --output tests/results/ray-vs-box2d-weed-busy.json",
    "bench:feature:ray-vs-box2d:box2d:idle": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/RayVsBox2dStressScene.js --scene-export RayVsBox2dBoxIdleScene --output tests/results/ray-vs-box2d-box-idle.json",
    "bench:feature:ray-vs-box2d:box2d:busy": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/RayVsBox2dStressScene.js --scene-export RayVsBox2dBoxBusyScene --output tests/results/ray-vs-box2d-box-busy.json",
    "bench:feature:ray:predator": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /demos/predatorScene/predatorScene.js --scene-export PredatorScene --output tests/results/ray-predator.json",
    "bench:ray:hyps": "node tests/bench/run-ray-hyp-campaign.mjs",
    "bench:ray:tournament": "node tests/bench/run-ray-hyp-tournament.mjs",
    "bench:micro:decal": "node tests/bench/decal-microbench.mjs",
    "bench:feature:decal": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/DecalStampStressScene.js --scene-export DecalStampStressScene --output tests/results/decal-stress.json",
    "bench:decal:tournament": "node tests/bench/run-decal-hyp-tournament.mjs",
    "bench:micro:particle-emit": "node tests/bench/particle-emit-microbench.mjs",
    "bench:micro:particle-ease": "node tests/bench/particle-ease-microbench.mjs",
    "bench:micro:particle-integrate": "node tests/bench/particle-integrate-microbench.mjs",
    "bench:feature:particle-emit": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/ParticleEmitStressScene.js --scene-export ParticleEmitStressScene --output tests/results/particle-emit-stress.json",
    "bench:feature:particle-integrate": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/ParticleIntegrateStressScene.js --scene-export ParticleIntegrateStressScene --output tests/results/particle-integrate-stress.json",
    "bench:particle:tournament": "node tests/bench/run-particle-hyp-tournament.mjs",
    "bench:feature:liquidfun": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/LiquidFunStressScene.js --scene-export LiquidFunStressScene --output tests/results/liquidfun-stress.json",
    "bench:feature:liquidfun-query": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/LiquidFunQueryStressScene.js --scene-export LiquidFunQueryStressScene --output tests/results/liquidfun-query-stress.json",
    "bench:micro:liquidfun-capturepairs": "node tests/bench/liquidfun-capturepairs-microbench.mjs",
    "bench:micro:liquidfun-computedepth": "node tests/bench/liquidfun-computedepth-microbench.mjs",
    "bench:micro:log-pair": "node tests/bench/log-pair-microbench.mjs",
    "bench:micro:par-cam": "node tests/bench/par-cam-microbench.mjs",
    "bench:micro:pre-anim": "node tests/bench/pre-anim-microbench.mjs",
    "bench:micro:pre-hot": "node tests/bench/pre-hot-microbench.mjs",
    "bench:micro:layer-collect": "node tests/bench/layer-collect-microbench.mjs",
    "bench:micro:instanced-pack": "node tests/bench/instanced-pack-microbench.mjs",
    "bench:micro:sr-flags": "node tests/bench/sr-flags-microbench.mjs",
    "bench:micro:hyp-wins": "node tests/bench/run-hyp-wins-microbenches.mjs",
    "bench:micro:compute-pack": "node tests/bench/compute-pack-microbench.mjs",
    "bench:feature:compute": "node tests/bench/run-integrated-worker-benchmark.mjs --scene /tests/bench/stressScenes/ComputeStressScene.js --scene-export ComputeStressScene --output tests/results/compute-stress.json",
    "bench:feature:compute:headed": "node tests/bench/run-integrated-worker-benchmark.mjs --headed --scene /tests/bench/stressScenes/ComputeStressScene.js --scene-export ComputeStressScene --output tests/results/compute-stress-headed.json",
    "verify:pose-interpolation": "node tests/bench/poseInterpolationVerify.mjs",
    "bake:atlas": "node scripts/bake-big-atlas.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "premake_bundle": "node scripts/sync-version.js",
    "make_bundle": "node scripts/build-bundle.js",
    "make_bundle:obfuscate": "node scripts/build-bundle.js --obfuscate",
    "premake_prod_bundle": "node scripts/sync-version.js",
    "make_prod_bundle": "node scripts/build-bundle.js",
    "build:pixi": "node scripts/build-pixi.mjs",
    "prebuild:docs": "node scripts/sync-version.js",
    "build:docs": "node scripts/build-docs.js",
    "clean": "rimraf dist"
  },
  "keywords": [
    "weed.js",
    "weedjs",
    "game-engine",
    "web-game-engine",
    "html5-game-engine",
    "2d",
    "webgl",
    "multithreaded",
    "web-worker",
    "sharedarraybuffer",
    "box2d",
    "wasm",
    "ecs",
    "entity-component-system",
    "pixi.js",
    "physics"
  ],
  "author": "Facundo Saiegh",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brotochola/MultithreadedGameEngine.git"
  },
  "bugs": {
    "url": "https://github.com/brotochola/MultithreadedGameEngine/issues"
  },
  "homepage": "https://multithreaded-game-engine.vercel.app/demos",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "javascript-obfuscator": "^4.1.0",
    "pixi.js": "8.20.1",
    "playwright": "^1.62.1",
    "prettier": "^3.8.0",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-obfuscator": "^3.5.1"
  }
}
