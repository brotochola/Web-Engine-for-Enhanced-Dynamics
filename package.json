    "bench:feature:compute:headed": "node tests/bench/runIntegratedWorkerBenchmark.mjs --headed --scene /tests/bench/stressScenes/computeStressScene.js --scene-export ComputeStressScene --output tests/results/compute-stress-headed.json",
    "verify:pose-interpolation": "node tests/bench/poseInterpolationVerify.mjs",
    "bake:atlas": "node scripts/bakeBigAtlas.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "premake_bundle": "node scripts/syncVersion.js",
