# The register merges by key, not as text: scripts/mergeRegister.mjs, defined once per clone as that file says.
docs/internal/hypotheses.json merge=hypotheses

# N-453: every file checks out with the bytes the repository holds, whatever core.autocrlf says (Git for Windows sets it to
# true): 13 node tests look for a source's text by its line ends, and failed on such a clone. The CR LF files stay so.
* -text

# Shaders check out with LF whatever core.autocrlf says (Git for Windows sets it to true): the engine's rewrites find
# their lines by "\n", and a CR LF clone threw 'the sprite vertex shader needs one "void main() {"' (review N-169).
*.glsl text eol=lf
*.wgsl text eol=lf
