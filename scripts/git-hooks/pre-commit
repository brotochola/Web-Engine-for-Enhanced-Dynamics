#!/bin/sh
set -e

# Cursor / VS Code SCM often launches git with a thin PATH (no npm/node from nvm).
# CLI terminals usually have the full PATH — that is why bump worked only from the terminal.
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

resolve_node() {
  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi
  for candidate in \
    "/d/nvm/nodejs/node.exe" \
    "/d/Program Files/nodejs/node.exe" \
    "/c/Program Files/nodejs/node.exe" \
    "$LOCALAPPDATA/pnpm/nodejs/22.16.0/node.exe"
  do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

NODE_BIN="$(resolve_node)" || {
  echo "pre-commit: node not found. Open a terminal with node on PATH, or install Node." >&2
  exit 1
}

"$NODE_BIN" scripts/bumpPatchVersion.js
git add package.json src/version.js
# package-lock.json is gitignored in this repo — do not git add it.
